      "blocks": {
        "heading_BAzNaN": {
          "type": "heading",
          "settings": {
            "heading": "14. <a href=\"https://pubmed.ncbi.nlm.nih.gov/29131369/\">Treat Traumatic Brain Injury – TBI</a>"
          }
        },
        "text_aB9phB": {
          "type": "text",
          "settings": {
            "text": "<p>Near-infrared light has the ability to pass through bone and reach the tissues of the brain.</p><p>Red light therapy treatments that use near-infrared light can stimulate, regenerate, and preserve brain tissue and neurons while also reducing inflammation, which can be helpful in the treatment of mild traumatic brain injury.</p>"
          }
        }
      },

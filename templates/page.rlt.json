    "rich_text_XbEcrj": {
      "type": "rich-text",
      "blocks": {
        "heading_96mpXR": {
          "type": "heading",
          "settings": {
            "heading": "You get all of the benefits!"
          }
        },
        "text_e94ywB": {
          "type": "text",
          "settings": {
            "text": "<p>Red light therapy may sound like an ideal treatment option with a wide range of benefits, but it is not too good to be true.</p><p>It requires a bit of upfront investment in terms of time, with a few sessions per week for a few weeks, continued maintenance can be achieved with just one session per week.</p><p>This means that you can continue to enjoy all of the benefits of red light therapy with minimal ongoing effort.</p><p>If you are using red light therapy to improve your skin tone, minimize the visible signs of aging, and heal sun damage, you can expect to undergo red light therapy in 20-minute sessions, 3 to 5 times each week for one to four months. Then once a week as maintenance.</p>"
          }
        },

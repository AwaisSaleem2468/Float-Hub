{%- liquid
  assign text_size_desktop = section.settings.text_size_desktop | default: 13
  assign text_size_mobile = section.settings.text_size_mobile | default: 12
-%}

{% style %}
  #StaticFeature-{{ section.id }} {
    --sf-bg: {{ section.settings.background_color }};
    --sf-text: {{ section.settings.text_color }};
    --sf-icon: {{ section.settings.icon_color }};
    --sf-border: {{ section.settings.border_color }};
    --sf-border-width: {{ section.settings.border_width }}px;
    --sf-size: {{ text_size_desktop }}px;
    --sf-size-mobile: {{ text_size_mobile }}px;
    --sf-gap: {{ section.settings.item_gap }}px;
    background-color: var(--sf-bg);
    color: var(--sf-text);
    border-top: var(--sf-border-width) solid var(--sf-border);
    border-bottom: var(--sf-border-width) solid var(--sf-border);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #StaticFeature-{{ section.id }} .static-feature__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem var(--sf-gap);
    width: 100%;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #StaticFeature-{{ section.id }} .static-feature__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-family: var(--font-body-family);
    font-size: var(--sf-size);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--sf-text);
    white-space: nowrap;
  }

  #StaticFeature-{{ section.id }} .static-feature__item a {
    color: inherit;
    text-decoration: none;
  }

  #StaticFeature-{{ section.id }} .static-feature__item a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  #StaticFeature-{{ section.id }} .static-feature__icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
    color: var(--sf-icon);
  }

  #StaticFeature-{{ section.id }} .static-feature__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  @media screen and (max-width: 989px) {
    #StaticFeature-{{ section.id }} .static-feature__inner {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
      max-width: none;
    }

    #StaticFeature-{{ section.id }} .static-feature__inner::-webkit-scrollbar {
      display: none;
    }

    #StaticFeature-{{ section.id }} .static-feature__item {
      font-size: var(--sf-size-mobile);
      flex: 0 0 auto;
    }
  }

  @media screen and (max-width: 749px) {
    #StaticFeature-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.85 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.85 | round: 0 }}px;
    }
  }
{% endstyle %}

<section
  id="StaticFeature-{{ section.id }}"
  class="static-feature"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  {%- if section.blocks.size > 0 -%}
    <div class="static-feature__inner">
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          <p class="static-feature__item" {{ block.shopify_attributes }}>
            {%- if block.settings.show_icon -%}
              <span class="static-feature__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false">
                  <path d="M8 1.2l1.85 3.75 4.15.6-3 2.93.7 4.12L8 10.7l-3.7 1.9.7-4.12-3-2.93 4.15-.6L8 1.2z"/>
                </svg>
              </span>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Static Feature Bar",
  "tag": "section",
  "class": "section-static-feature",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Store highlights"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0B1220"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#C8CED8"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Star icon",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Top & bottom border",
      "default": "#243044"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size (desktop)",
      "default": 13
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 1280
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Space between items",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Feature highlight"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show star icon",
          "default": false
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Static Feature Bar",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "London's Highest Rated Float Centre",
            "show_icon": true
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "300+ Five-Star Reviews Online",
            "show_icon": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "6 Tanks - Largest in London",
            "show_icon": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Old Street, Shoreditch · EC1V 9NQ",
            "show_icon": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Open 7 Days - Book Online Instantly",
            "show_icon": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
